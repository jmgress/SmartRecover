# =============================================================================
# Incident Management Connector Configuration
# =============================================================================
# 
# WARNING: This is an example file. DO NOT commit your actual .env file with
# real credentials to version control! 
#
# To use:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual credentials in the .env file
# 3. Ensure .env is in your .gitignore (it should be by default)
# =============================================================================

# Choose one of: mock, servicenow, jira, splunk
INCIDENT_CONNECTOR_TYPE=mock

# Mock Data Configuration (when INCIDENT_CONNECTOR_TYPE=mock)
MOCK_DATA_SOURCE=mock

# ServiceNow Configuration (when INCIDENT_CONNECTOR_TYPE=servicenow)
# Use username/password for basic authentication (default method)
# SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# SERVICENOW_USERNAME=your-username
# SERVICENOW_PASSWORD=your-password

# ServiceNow OAuth Configuration (optional - use instead of username/password)
# If you have OAuth configured in ServiceNow, use these instead of username/password
# SERVICENOW_CLIENT_ID=your-client-id
# SERVICENOW_CLIENT_SECRET=your-client-secret

# Jira Service Management Configuration (when INCIDENT_CONNECTOR_TYPE=jira)
# Note: JIRA_API_TOKEN should be generated from your Atlassian account settings
# Go to: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_USERNAME=your-email@example.com
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECT_KEY=PROJ

# Splunk Configuration (when INCIDENT_CONNECTOR_TYPE=splunk)
# Use a token when possible; username/password is supported as a fallback.
# SPLUNK_BASE_URL=https://splunk.example.com:8089
# SPLUNK_HOST=splunk.example.com
# SPLUNK_PORT=8089
# SPLUNK_TOKEN=your-splunk-token
# SPLUNK_USERNAME=your-username
# SPLUNK_PASSWORD=your-password
# SPLUNK_INDEX=main
# SPLUNK_VERIFY_SSL=true
# SPLUNK_INCIDENTS_SEARCH=search index="{index}" sourcetype=smartrecover:incident | head 20
# SPLUNK_INCIDENT_LOOKUP_SEARCH=search index="{index}" sourcetype=smartrecover:incident incident_id="{incident_id}" | head 1
# SPLUNK_SIMILAR_INCIDENTS_SEARCH=search index="{index}" sourcetype=smartrecover:incident incident_id!="{incident_id}" | search "{context}" | head 10
# SPLUNK_RELATED_CHANGES_SEARCH=search index="{index}" sourcetype=smartrecover:change incident_id="{incident_id}" | head 10
# SPLUNK_RESOLUTIONS_SEARCH=search index="{index}" sourcetype=smartrecover:incident incident_id!="{incident_id}" | search "{context}" | fields resolution close_notes
